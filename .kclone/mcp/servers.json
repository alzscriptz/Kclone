{
  "version": 1,
  "projectAware": true,
  "scope": "project",
  "mcpServers": {
    "kclone-workspace": {
      "transport": "stdio",
      "command": "python",
      "args": ["kclone_mcp_server.py", "--root", "."],
      "enabled": true
    }
  },
  "capabilities": [
    "tools",
    "resources",
    "workspace",
    "files",
    "assets",
    "resources",
    "build",
    "tests",
    "git",
    "vm"
  ]
}
